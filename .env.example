# ==========================================
# CẤU HÌNH CLAUDE (ANTHROPIC) API
# Lấy API Key tại: https://console.anthropic.com/settings/keys
# ==========================================
# Model Claude mặc định (tối ưu trích xuất đề, Hán tự và giải thích chi tiết N3)
# - claude-3-5-sonnet-20241022 (Khuyến nghị: thông minh nhất, đọc hiểu N3 sâu sắc)
# - claude-3-5-haiku-20241022 (Tốc độ siêu nhanh, chi phí siêu tiết kiệm)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# CẤU HÌNH QUẢN TRỊ VIÊN (ADMIN)
# Dùng để xác thực quyền Upload, Duyệt đề, Tạo giải thích
# ==========================================
ADMIN_SECRET=admin123

# ==========================================
# DỰ PHÒNG: GOOGLE GEMINI API (Tùy chọn)
# ==========================================
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
