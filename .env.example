# Google Gemini API Key
# Lấy API key miễn phí hoặc trả phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model mặc định (tối ưu tốc độ và chất lượng cho JLPT N3)
GEMINI_MODEL=gemini-2.5-flash

# Admin Secret Token dùng để xác thực các API Quản trị viên (Upload, Duyệt đề, Tạo giải thích)
ADMIN_SECRET=admin123

